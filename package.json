{
  "name": "ice-tech-development",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run images && next dev",
    "images": "node scripts/optimize-images.mjs",
    "build": "npm run images && next build && node scripts/finalize-export.mjs",
    "start": "node scripts/preview.mjs",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run build && npm test && npm audit --omit=dev",
    "release": "npm run check && node scripts/package-release.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.6",
    "sharp": "0.35.5",
    "typescript": "^5.9.0"
  }
}
